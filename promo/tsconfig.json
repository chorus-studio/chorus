{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "lib": ["DOM", "ES2022"],
        "noEmit": true
    },
    "include": ["src", "remotion.config.ts"]
}
